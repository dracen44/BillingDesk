<Window x:Class="BillingDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BillingDesk"
        xmlns:views="clr-namespace:BillingDesk.Views"
        mc:Ignorable="d"
        Title="BillingDesk"
        Height="900"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F1">

    <DockPanel>
        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="240" Background="#2C3E50">
            <StackPanel Orientation="Vertical">
                <!-- Branding Header -->
                <Border Background="#1A252F" Padding="16">
                    <StackPanel>
                        <TextBlock Text="BillingDesk" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Billing Management" Foreground="#95A5A6" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Separator Background="#34495E"/>

                <!-- Navigation Menu -->
                <StackPanel>
                    <Button x:Name="DashboardButton" Content="📊 Dashboard" Click="Dashboard_Click" 
                            Background="Transparent" Foreground="#ECF0F1" 
                            Padding="16,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            BorderThickness="0" Cursor="Hand"/>

                    <Button x:Name="CustomersButton" Content="👥 Customers" Click="Customers_Click"
                            Background="Transparent" Foreground="#ECF0F1" 
                            Padding="16,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            BorderThickness="0" Cursor="Hand"/>

                    <Button x:Name="InvoicesButton" Content="📄 Invoices" Click="Invoices_Click"
                            Background="Transparent" Foreground="#ECF0F1" 
                            Padding="16,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            BorderThickness="0" Cursor="Hand"/>

                    <Button x:Name="PaymentsButton" Content="💳 Payments" Click="Payments_Click"
                            Background="Transparent" Foreground="#ECF0F1" 
                            Padding="16,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <Separator Background="#34495E" Margin="0,16"/>

                <!-- Footer Info -->
                <StackPanel VerticalAlignment="Bottom" Margin="16">
                    <TextBlock Text="PortfolioBillingDemo" Foreground="#7F8C8D" FontSize="10" TextAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Border Grid.Row="0" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1" Padding="24,16">
                <TextBlock x:Name="PageTitle" Text="{Binding CurrentPageTitle}" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
            </Border>

            <!-- Page Content -->
            <ContentControl Grid.Row="1" x:Name="ContentArea"/>
        </Grid>
    </DockPanel>
</Window>
