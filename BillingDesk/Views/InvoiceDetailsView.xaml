<UserControl x:Class="BillingDesk.Views.InvoiceDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Back Button -->
        <Border Grid.Row="0" Padding="24,16" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <Button Command="{Binding GoBackCommand}"
                    Content="← Back to Invoices"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="16,8"
                    HorizontalAlignment="Left"/>
        </Border>

        <!-- Loading State -->
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Loading invoice details..." FontSize="14" Foreground="#95A5A6" TextAlignment="Center"/>
        </StackPanel>

        <!-- Error State -->
        <Border Grid.Row="1" 
                Background="#FFF3CD" 
                BorderBrush="#FFC107" 
                BorderThickness="1"
                Padding="16"
                Margin="24,12,24,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#856404" TextWrapping="Wrap"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,24">
                <!-- Invoice Information Card -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Invoice Information" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Invoice ID -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Invoice ID:" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InvoiceDetail.InvoiceId}" Foreground="#2C3E50"/>

                            <!-- Invoice Date -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Invoice Date:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InvoiceDetail.InvoiceDate, StringFormat=yyyy-MM-dd}" Foreground="#2C3E50"/>

                            <!-- Due Date -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Due Date:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InvoiceDetail.DueDate, StringFormat=yyyy-MM-dd}" Foreground="#2C3E50"/>

                            <!-- Status -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Status:" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding InvoiceDetail.StatusDisplay}" Foreground="#2C3E50"/>

                            <!-- Overdue Indicator -->
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Overdue:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding InvoiceDetail.OverdueDisplay}" Foreground="#2C3E50"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Customer Information Card -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Customer Information" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Customer ID -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer ID:" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InvoiceDetail.CustomerId}" Foreground="#2C3E50"/>

                            <!-- Customer Name -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InvoiceDetail.CustomerName}" Foreground="#2C3E50"/>

                            <!-- Customer Email -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InvoiceDetail.CustomerEmail}" Foreground="#2C3E50"/>

                            <!-- Customer Status -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Status:" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding InvoiceDetail.CustomerStatus}" Foreground="#2C3E50"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Financial Summary Cards -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Billed -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,16">
                        <StackPanel>
                            <TextBlock Text="Total Billed" FontSize="12" Foreground="#95A5A6"/>
                            <TextBlock Text="{Binding InvoiceDetail.InvoiceTotal, StringFormat='${0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#3498DB" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Paid -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="4,0,8,16">
                        <StackPanel>
                            <TextBlock Text="Total Paid" FontSize="12" Foreground="#95A5A6"/>
                            <TextBlock Text="{Binding InvoiceDetail.TotalPaid, StringFormat='${0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#27AE60" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Balance -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="4,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Remaining Balance" FontSize="12" Foreground="#95A5A6"/>
                            <TextBlock Text="{Binding InvoiceDetail.Balance, StringFormat='${0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#E74C3C" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Record Payment -->
                <Button Command="{Binding RecordPaymentCommand}"
                        Content="Record Payment"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="16,8"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"/>

                <!-- Payment Entry Form -->
                <Border Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,20"
                        Visibility="{Binding IsPaymentFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Record Payment" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Invoice ID:" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InvoiceDetail.InvoiceId}" Foreground="#2C3E50"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Customer:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding InvoiceDetail.CustomerName}" Foreground="#2C3E50"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Invoice Total:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InvoiceDetail.InvoiceTotal, StringFormat='${0:N2}'}" Foreground="#2C3E50" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Already Paid:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding InvoiceDetail.TotalPaid, StringFormat='${0:N2}'}" Foreground="#2C3E50" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Remaining Balance:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InvoiceDetail.Balance, StringFormat='${0:N2}'}" Foreground="#2C3E50" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Payment Amount:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,12,0,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" MaxLength="20"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Payment Date:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,12,0,0"/>
                            <DatePicker Grid.Row="3" Grid.Column="3" SelectedDate="{Binding PaymentDate}" Margin="0,12,0,0"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                                       Text="{Binding PaymentFormError}"
                                       Foreground="#C0392B"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding PaymentFormError, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                            <Button Command="{Binding SubmitPaymentCommand}"
                                    Content="Save Payment"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="16,8"
                                    Margin="0,0,8,0"/>
                            <Button Command="{Binding CancelPaymentCommand}"
                                    Content="Cancel"
                                    Padding="16,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Line Items Section -->
                <TextBlock Text="Line Items" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,24,0,12"/>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <DataGrid ItemsSource="{Binding LineItems}"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              AutoGenerateColumns="False"
                              Style="{StaticResource DataGridStyle}"
                              Background="#FFFFFF"
                              Foreground="#2C3E50">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat='${0:N2}'}" Width="100"/>
                            <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat='${0:N2}'}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Payment History Section -->
                <TextBlock Text="Payment History" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,24,0,12"/>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Payments}"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  AutoGenerateColumns="False"
                                  Style="{StaticResource DataGridStyle}"
                                  Background="#FFFFFF"
                                  Foreground="#2C3E50">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Payment Date" Binding="{Binding PaymentDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='${0:N2}'}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- No Payments Message -->
                        <TextBlock Text="No payments recorded" 
                                   FontSize="12" 
                                   Foreground="#95A5A6" 
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Payments.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverted}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
