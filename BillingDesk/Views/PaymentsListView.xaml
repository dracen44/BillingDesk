<UserControl x:Class="BillingDesk.Views.PaymentsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:BillingDesk.Converters"
             mc:Ignorable="d"
             Background="#FFFFFF">
    <!-- Resources Section: Ensures converters and styles are available during XAML parsing -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Import shared styles -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search and Filters -->
        <Border Grid.Row="0" Padding="24,16" Background="#F8F9FA" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search TextBox -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Search" FontSize="12" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,12,0">
                        <TextBox ToolTip="Search by payment #, invoice #, customer name, or email"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Foreground="#2C3E50"
                                 Background="#FFFFFF"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1"/>
                        <TextBlock Text="Payment #, invoice #, customer name, or email"
                                   Foreground="#95A5A6"
                                   Padding="13,8"
                                   IsHitTestVisible="False"
                                   Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchTerm}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <!-- From Date -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Payment From" FontSize="12" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding FromDate}"
                                Width="150"
                                Margin="0,0,12,0"/>
                </StackPanel>

                <!-- To Date -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Payment To" FontSize="12" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding ToDate}"
                                Width="150"
                                Margin="0,0,12,0"/>
                </StackPanel>

                <!-- Clear Filters Button -->
                <Button Grid.Column="3"
                        Command="{Binding ClearFiltersCommand}"
                        Content="Clear Filters" VerticalAlignment="Bottom"
                        Padding="12,8"
                        Background="#95A5A6"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Margin="0,0,12,0"
                        Cursor="Hand"/>

                <!-- Refresh Button -->
                <Button Grid.Column="4"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh" VerticalAlignment="Bottom"
                        Padding="12,8"
                        Background="#3498DB"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Loading State -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Loading payments..." FontSize="14" Foreground="#95A5A6" TextAlignment="Center"/>
        </StackPanel>

        <!-- Error State -->
        <Border Grid.Row="1"
                Background="#FFF3CD"
                BorderBrush="#FFC107"
                BorderThickness="1"
                Padding="16"
                Margin="24,12,24,0"
                VerticalAlignment="Top"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#856404" TextWrapping="Wrap"/>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="24,24,24,24">
            <Grid>
                <DataGrid ItemsSource="{Binding Payments}"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          AutoGenerateColumns="False"
                          ColumnWidth="*"
                          MinColumnWidth="90"
                          HorizontalScrollBarVisibility="Auto"
                          Style="{StaticResource DataGridStyle}"
                          Background="#FFFFFF"
                          Foreground="#2C3E50"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Payment #" Binding="{Binding PaymentId}" Width="100" MinWidth="90"/>
                        <DataGridTextColumn Header="Payment Date" Binding="{Binding PaymentDate, StringFormat=yyyy-MM-dd}" Width="120" MinWidth="110"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="2*" MinWidth="180"/>
                        <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceId}" Width="100" MinWidth="90"/>
                        <DataGridTextColumn Header="Invoice Total" Binding="{Binding InvoiceTotal, StringFormat='${0:N2}'}" Width="130" MinWidth="120"/>
                        <DataGridTextColumn Header="Payment Amount" Binding="{Binding PaymentAmount, StringFormat='${0:N2}'}" Width="150" MinWidth="130"/>
                        <DataGridTextColumn Header="Remaining Balance" Binding="{Binding RemainingBalance, StringFormat='${0:N2}'}" Width="160" MinWidth="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <TextBlock Text="No payments found"
                           FontSize="12"
                           Foreground="#95A5A6"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,40"
                           Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- Paging Footer -->
        <Border Grid.Row="2" Padding="24,12" Background="#F8F9FA" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding PageSummary}" VerticalAlignment="Center" Foreground="#2C3E50"/>

                <Button Grid.Column="1"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                        Content="Previous"
                        Padding="12,8"
                        Margin="0,0,8,0"
                        Background="#3498DB"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Grid.Column="2"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        Content="Next"
                        Padding="12,8"
                        Background="#3498DB"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
