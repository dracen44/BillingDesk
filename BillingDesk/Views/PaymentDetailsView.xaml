<UserControl x:Class="BillingDesk.Views.PaymentDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#FFFFFF">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Back Button -->
        <Border Grid.Row="0" Padding="24,16" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding GoBackCommand}"
                        Content="← Back to Payments"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="16,8"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Loading State -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,40"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Loading payment details..." FontSize="14" Foreground="#95A5A6" TextAlignment="Center"/>
        </StackPanel>

        <!-- Error State -->
        <Border Grid.Row="1"
                Background="#FFF3CD"
                BorderBrush="#FFC107"
                BorderThickness="1"
                Padding="16"
                Margin="24,12,24,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#856404" TextWrapping="Wrap"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" DataContext="{Binding PaymentDetail}">
                <!-- Payment Information Card -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Payment Information" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Payment ID:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PaymentId}" Foreground="#2C3E50"/>

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Payment Date:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding PaymentDate, StringFormat=yyyy-MM-dd}" Foreground="#2C3E50"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Payment Amount:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,12,12,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PaymentAmount, StringFormat='${0:N2}'}" Foreground="#2C3E50" Margin="0,12,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Related Invoice and Customer Card -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Related Invoice and Customer" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Invoice ID:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InvoiceId}" Foreground="#2C3E50"/>

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Invoice Status:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding StatusDisplay}" Foreground="#2C3E50"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,12,12,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CustomerName}" Foreground="#2C3E50" Margin="0,12,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,12,12,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CustomerEmail}" Foreground="#2C3E50" Margin="0,12,0,0"/>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Command="{Binding DataContext.ViewInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Content="View Invoice"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="16,8"
                                        Margin="0,0,12,0"/>
                                <Button Command="{Binding DataContext.ViewCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Content="View Customer"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="16,8"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Financial Summary Cards -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Invoice Total" FontSize="12" Foreground="#95A5A6"/>
                            <TextBlock Text="{Binding InvoiceTotal, StringFormat='${0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#3498DB" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Total Paid On Invoice" FontSize="12" Foreground="#95A5A6"/>
                            <TextBlock Text="{Binding TotalPaid, StringFormat='${0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#27AE60" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Remaining Balance" FontSize="12" Foreground="#95A5A6"/>
                            <TextBlock Text="{Binding RemainingBalance, StringFormat='${0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#E74C3C" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
