<UserControl x:Class="BillingDesk.Views.InvoicesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:BillingDesk.Converters"
             mc:Ignorable="d"
             Background="#FFFFFF">
    <!-- Resources Section: Ensures converters and styles are available during XAML parsing -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Import shared styles -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search and Filters -->
        <Border Grid.Row="0" Padding="24,16" Background="#F8F9FA" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search TextBox -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Search" FontSize="12" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,4"/>
                <TextBox ToolTip="Search by invoice #, customer name, or email"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,8"
                         Foreground="#2C3E50"
                         Background="#FFFFFF"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         Margin="0,0,12,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#2C3E50"/>
                            <Setter Property="BorderBrush" Value="#BDC3C7"/>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                </StackPanel>

                <!-- Status Filter ComboBox -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,4"/>
                <ComboBox
                          SelectedValue="{Binding StatusFilter}"
                          SelectedValuePath="Content"
                          Padding="12,8"
                          Foreground="#2C3E50"
                          Background="#FFFFFF"
                          BorderBrush="#BDC3C7"
                          BorderThickness="1"
                          Margin="0,0,12,0"
                          Width="120">
                    <ComboBoxItem Content=""/>
                    <ComboBoxItem Content="Open"/>
                    <ComboBoxItem Content="Paid"/>
                </ComboBox>
                                </StackPanel>

                <!-- Clear Filters Button -->
                <Button Grid.Column="2"
                        Command="{Binding ClearFiltersCommand}"
                        Content="Clear Filters" VerticalAlignment="Bottom"
                        Padding="12,8"
                        Background="#95A5A6"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Margin="0,0,12,0"
                        Cursor="Hand"/>

                <!-- Refresh Button -->
                <Button Grid.Column="3"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh" VerticalAlignment="Bottom"
                        Padding="12,8"
                        Background="#3498DB"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Loading State -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Loading invoices..." FontSize="14" Foreground="#95A5A6" TextAlignment="Center"/>
        </StackPanel>

        <!-- Error State -->
        <Border Grid.Row="1"
                Background="#FFF3CD" 
                BorderBrush="#FFC107" 
                BorderThickness="1"
                Padding="16"
                Margin="24,12,24,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#856404" TextWrapping="Wrap"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardBorderStyle}" Margin="24,24,24,24">
                <DataGrid ItemsSource="{Binding Invoices}"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          AutoGenerateColumns="False"
                          Style="{StaticResource DataGridStyle}"
                          Background="#FFFFFF"
                          Foreground="#2C3E50"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceId}" Width="90"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="150"/>
                        <DataGridTextColumn Header="Invoice Date" Binding="{Binding InvoiceDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding InvoiceTotal, StringFormat='${0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="Paid" Binding="{Binding TotalPaid, StringFormat='${0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='${0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </ScrollViewer>

        <!-- Paging Footer -->
        <Border Grid.Row="2" Padding="24,12" Background="#F8F9FA" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding PageSummary}" VerticalAlignment="Center" Foreground="#2C3E50"/>

                <Button Grid.Column="1"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                        Content="Previous"
                        Padding="12,8"
                        Margin="0,0,8,0"
                        Background="#3498DB"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Grid.Column="2"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        Content="Next"
                        Padding="12,8"
                        Background="#3498DB"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>