<UserControl x:Class="BillingDesk.Views.CustomerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Back Button -->
        <Border Grid.Row="0" Padding="24,16" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <Button Command="{Binding GoBackCommand}"
                    Content="← Back to Customers"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="16,8"
                    HorizontalAlignment="Left"/>
        </Border>

        <!-- Loading State -->
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Loading customer details..." FontSize="14" Foreground="#95A5A6" TextAlignment="Center"/>
        </StackPanel>

        <!-- Error State -->
        <Border Grid.Row="1" 
                Background="#FFF3CD" 
                BorderBrush="#FFC107" 
                BorderThickness="1"
                Padding="16"
                Margin="24,12,24,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#856404" TextWrapping="Wrap"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,24">
                <!-- Customer Information Card -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Customer Information" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ID -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer ID:" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CustomerDetail.CustomerId}" Foreground="#95A5A6"/>

                            <!-- Name -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CustomerDetail.FullName}" Foreground="#95A5A6" Margin="0,8,0,0"/>

                            <!-- Email -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CustomerDetail.Email}" Foreground="#95A5A6" Margin="0,8,0,0" TextWrapping="Wrap"/>

                            <!-- Status -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Status:" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding CustomerDetail.StatusDisplay}" Foreground="#95A5A6"/>

                            <!-- Created Date -->
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Created Date:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CustomerDetail.CreatedDate, StringFormat=yyyy-MM-dd}" Foreground="#95A5A6" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Billing Summary Cards -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Billed -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,16">
                        <StackPanel>
                            <TextBlock Text="Total Billed" FontSize="12" Foreground="#95A5A6"/>
                            <TextBlock Text="{Binding CustomerDetail.TotalBilled, StringFormat='${0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#3498DB" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Paid -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="4,0,8,16">
                        <StackPanel>
                            <TextBlock Text="Total Paid" FontSize="12" Foreground="#95A5A6"/>
                            <TextBlock Text="{Binding CustomerDetail.TotalPaid, StringFormat='${0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#27AE60" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Outstanding Balance -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="4,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Outstanding Balance" FontSize="12" Foreground="#95A5A6"/>
                            <TextBlock Text="{Binding CustomerDetail.OutstandingBalance, StringFormat='${0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#E74C3C" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Invoice History Section -->
                <TextBlock Text="Invoice History" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,24,0,12"/>

                <!-- Invoice History DataGrid -->
                <Border Style="{StaticResource CardBorderStyle}" 
                        Visibility="{Binding Invoices.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverted}">
                    <DataGrid ItemsSource="{Binding Invoices}"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              AutoGenerateColumns="False"
                              Style="{StaticResource DataGridStyle}"
                              Background="#FFFFFF"
                              Foreground="#2C3E50">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceId}" Width="100"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding InvoiceTotal, StringFormat='${0:N2}'}" Width="100"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding TotalPaid, StringFormat='${0:N2}'}" Width="100"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='${0:N2}'}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Empty Invoice Message -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,40"
                            Visibility="Collapsed">
                    <TextBlock Text="No invoices found" FontSize="14" Foreground="#95A5A6" TextAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
