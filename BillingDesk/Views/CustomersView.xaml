<UserControl x:Class="BillingDesk.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,24,24,12" Background="#FFFFFF">
            <StackPanel>
                <TextBlock Text="Customers" FontSize="20" FontWeight="SemiBold" Foreground="#2C3E50"/>
                <TextBlock Text="Search and review customer accounts" FontSize="12" Foreground="#95A5A6" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Search Area -->
        <Border Grid.Row="1" Padding="24,12,24,12" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="SearchBox"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,8"
                         Background="#F8F9FA"
                         BorderBrush="#BDC3C7"
                         Foreground="#2C3E50"
                         FontSize="13"
                         ToolTip="Search by First Name, Last Name, or Email"/>

                <Button Grid.Column="1"
                        Command="{Binding ClearSearchCommand}"
                        Content="Clear"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="12,0,0,0"
                        Padding="20,8"/>

                <Button Grid.Column="2"
                        Command="{Binding RefreshCommand}"
                        Content="↻ Refresh"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="8,0,0,0"
                        Padding="20,8"/>
            </Grid>
        </Border>

        <!-- Loading/Error Area -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Loading customers..." FontSize="14" Foreground="#95A5A6" TextAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="2" 
                Background="#FFF3CD" 
                BorderBrush="#FFC107" 
                BorderThickness="1"
                Padding="16"
                Margin="24"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#856404" TextWrapping="Wrap"/>
        </Border>

        <!-- Customers DataGrid -->
        <Border Grid.Row="2" 
                Margin="24,12,24,12"
                Padding="0"
                Style="{StaticResource CardBorderStyle}"
                Visibility="{Binding Customers.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverted}">
            <DataGrid ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer}"
                      MouseDoubleClick="CustomerRow_DoubleClick"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      AutoGenerateColumns="False"
                      Style="{StaticResource DataGridStyle}"
                      Background="#FFFFFF"
                      Foreground="#2C3E50">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer ID" Binding="{Binding CustomerId}" Width="80"/>
                    <DataGridTextColumn Header="Customer Name" Binding="{Binding FullName, Mode=OneWay}" Width="200"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="250"/>
                    <DataGridTextColumn Header="Status" 
                                       Binding="{Binding Status}" 
                                       Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Active">
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                        <Setter Property="Foreground" Value="#95A5A6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Invoices" Binding="{Binding InvoiceCount, StringFormat={}{0:N0}}" Width="80"/>
                    <DataGridTextColumn Header="Total Billed" Binding="{Binding TotalBilled, StringFormat=\${0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="Total Paid" Binding="{Binding TotalPaid, StringFormat=\${0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingBalance, StringFormat=\${0:N2}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Empty State -->
        <StackPanel Grid.Row="2" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Visibility="{Binding Customers.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <TextBlock Text="No customers found" FontSize="16" FontWeight="SemiBold" Foreground="#95A5A6" TextAlignment="Center"/>
            <TextBlock Text="Try adjusting your search criteria" FontSize="12" Foreground="#BDC3C7" TextAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Pagination -->
        <Border Grid.Row="3" 
                Padding="24,16" 
                BorderBrush="#BDC3C7" 
                BorderThickness="0,1,0,0"
                Background="#FAFAFA">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding PreviousPageCommand}"
                        Content="← Previous"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="16,8"/>

                <StackPanel Margin="16,0" VerticalAlignment="Center">
                    <TextBlock TextAlignment="Center">
                        <Run Text="Page "/>
                        <Run Text="{Binding CurrentPageNumber, Mode=OneWay}"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                        <Run Text=" ("/>
                        <Run Text="{Binding TotalCount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                        <Run Text=" total)"/>
                    </TextBlock>
                </StackPanel>

                <Button Command="{Binding NextPageCommand}"
                        Content="Next →"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="16,8"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
